          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH base AS (SELECT e.id, CASE WHEN hr.execution_id IS NOT NULL AND xr.execution_id IS NOT NULL AND COALESCE(a.artifacts_count, 0) > 0 THEN 1 ELSE 0 END AS has_traceability FROM executions e LEFT JOIN header_results hr ON hr.execution_id = e.id LEFT JOIN xss_results xr ON xr.execution_id = e.id LEFT JOIN (SELECT execution_id, COUNT(*) AS artifacts_count FROM artifacts GROUP BY execution_id) a ON a.execution_id = e.id WHERE e.status = 'finished') SELECT COALESCE(ROUND((SUM(has_traceability)::numeric / NULLIF(COUNT(*)::numeric, 0)) * 100, 2), 0) AS value FROM base;",
          "refId": "A"
        }
      ],
      "title": "Trazabilidad básica",
      "type": "stat"
