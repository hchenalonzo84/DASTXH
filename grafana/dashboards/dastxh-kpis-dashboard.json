          "rawQuery": true,
          "rawSql": "WITH vulnerables AS (SELECT e.id, COALESCE(xr.findings_count, 0) AS findings_count FROM executions e LEFT JOIN xss_results xr ON xr.execution_id = e.id WHERE e.status = 'finished' AND (e.target_url ILIKE '%lab-05-xss-basic%' OR e.target_url ILIKE '%lab-06-xss-filtered-partial%' OR e.target_url ILIKE '%sitioVM%' OR e.target_url ILIKE '%checkout%' OR e.target_url ILIKE '%comments?message=%')) SELECT COALESCE(ROUND((COUNT(*) FILTER (WHERE findings_count > 0)::numeric / NULLIF(COUNT(*)::numeric, 0)) * 100, 2), 0) AS value FROM vulnerables;",
          "refId": "A"
        }
