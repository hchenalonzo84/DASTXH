          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ordered AS (SELECT e.id, e.target_url, e.status, e.started_at, e.finished_at, CASE WHEN e.started_at IS NOT NULL AND e.finished_at IS NOT NULL THEN ROUND((EXTRACT(EPOCH FROM (e.finished_at - e.started_at)) / 60)::numeric, 2) ELSE NULL END AS duracion_minutos, ROUND(EXTRACT(EPOCH FROM (e.started_at - LAG(e.started_at) OVER (ORDER BY e.started_at)))::numeric, 2) AS diferencia_inicio_anterior_seg FROM executions e WHERE e.started_at IS NOT NULL) SELECT id AS \"ID\", target_url AS \"Objetivo\", status AS \"Estado\", started_at AS \"Inicio\", finished_at AS \"Fin\", duracion_minutos AS \"Duración minutos\", diferencia_inicio_anterior_seg AS \"Diferencia inicio anterior seg\" FROM ordered ORDER BY started_at DESC LIMIT 30;",
          "refId": "A"
        }
