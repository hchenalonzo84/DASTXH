          "rawSql": "SELECT 'Presentes' AS \"Estado\", COALESCE(SUM(hr.headers_presentes), 0) AS \"Total\" FROM header_results hr INNER JOIN executions e ON e.id = hr.execution_id WHERE e.status = 'finished' UNION ALL SELECT 'Faltantes' AS \"Estado\", COALESCE(SUM(GREATEST(hr.headers_evaluadas - hr.headers_presentes, 0)), 0) AS \"Total\" FROM header_results hr INNER JOIN executions e ON e.id = hr.execution_id WHERE e.status = 'finished';",
          "refId": "A"
        }
      ],
      "title": "Cabeceras presentes vs faltantes",
      "type": "barchart"
    },
