        {
          "datasource": {
            "type": "postgres",
            "uid": "dastxh-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH vulnerables AS (SELECT e.id, COALESCE(xr.findings_count, 0) AS findings_count FROM executions e LEFT JOIN xss_results xr ON xr.execution_id = e.id WHERE e.status = 'finished' AND (e.target_url ILIKE '%lab-05-xss-basic%' OR e.target_url ILIKE '%lab-06-xss-filtered-partial%' OR e.target_url ILIKE '%sitioVM%' OR e.target_url ILIKE '%checkout%' OR e.target_url ILIKE '%comments?message=%')) SELECT CASE WHEN findings_count > 0 THEN 'Detectadas' ELSE 'No detectadas' END AS \"Resultado\", COUNT(*) AS \"Total\" FROM vulnerables GROUP BY CASE WHEN findings_count > 0 THEN 'Detectadas' ELSE 'No detectadas' END ORDER BY \"Resultado\";",
          "refId": "A"
        }
      ],
      "title": "Escenarios vulnerables detectados vs no detectados",
