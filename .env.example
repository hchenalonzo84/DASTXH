# ==========================================================
# DASTXH - Base de datos principal
# ==========================================================
POSTGRES_DB=dastxh
POSTGRES_USER=dastxh_user
POSTGRES_PASSWORD=dastxh_pass
POSTGRES_PORT=5432

# ==========================================================
# DASTXH - Backend / GUI
# ==========================================================
DEFAULT_TIMEOUT_SECONDS=30
WEB_PORT=8000

# ==========================================================
# pgAdmin
# ==========================================================
PGADMIN_DEFAULT_EMAIL=admin@dastxhdemo.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# ==========================================================
# Laboratorio combinado
# Base de datos propia del laboratorio
# ==========================================================
COMBO_LAB_POSTGRES_DB=combo_lab
COMBO_LAB_POSTGRES_USER=combo_user
COMBO_LAB_POSTGRES_PASSWORD=combo_pass
COMBO_LAB_POSTGRES_PORT=5543

# Puerto web del laboratorio
COMBO_LAB_PORT=5003

# ==========================================================
# DASTXH - Interpretación XSS con IA local
# Docker Model Runner / endpoint OpenAI-compatible
# ==========================================================
DASTXH_AI_ENABLED=true
DASTXH_AI_BASE_URL=http://model-runner.docker.internal:12434/engines/v1
DASTXH_AI_MODEL=ai/llama3.2
DASTXH_AI_API_KEY=not-needed

# Tiempo máximo por llamada/lote al modelo.
# No es timeout global del escaneo completo.
DASTXH_AI_TIMEOUT_SECONDS=420

# Máximo de tokens que puede generar el modelo por lote.
# Ayuda a evitar respuestas demasiado largas o lentas.
DASTXH_AI_MAX_TOKENS=1200

# Temperatura baja para que responda más estable y con JSON más consistente.
DASTXH_AI_TEMPERATURE=0.1

# Máximo de grupos XSS que se enviarán a IA.
# Normalmente 20 es suficiente porque ya se agrupa antes.
DASTXH_AI_MAX_GROUPS=20

# Cantidad de grupos por llamada al modelo.
# 5 es buen punto inicial para evitar HTTP 400 por prompts grandes.
DASTXH_AI_BATCH_SIZE=5

# Cantidad máxima de payloads representativos por grupo.
DASTXH_AI_MAX_PAYLOADS_PER_GROUP=2

# Longitud máxima de cada payload enviado a IA.
DASTXH_AI_MAX_PAYLOAD_CHARS=180

# Cantidad máxima de evidencias representativas por grupo.
DASTXH_AI_MAX_EVIDENCE_PER_GROUP=1

# Longitud máxima de cada evidencia enviada a IA.
DASTXH_AI_MAX_EVIDENCE_CHARS=260

# ==========================================================
# DASTXH - Traducción hsecscan con IA local
# Docker Model Runner / endpoint OpenAI-compatible
# ==========================================================
# Activa la traducción asistida para los campos de hsecscan:
# - Descripción
# - Recomendación
# - CWE
#
# Importante:
# Esta función NO interpreta nuevos riesgos.
# Solo traduce al español latino los textos técnicos ya generados por hsecscan.
DASTXH_HSECSCAN_AI_TRANSLATION_ENABLED=true

# Se reutiliza el mismo endpoint local compatible con OpenAI.
DASTXH_HSECSCAN_AI_TRANSLATION_BASE_URL=http://model-runner.docker.internal:12434/engines/v1

# Se reutiliza el mismo modelo local.
DASTXH_HSECSCAN_AI_TRANSLATION_MODEL=ai/llama3.2

# Docker Model Runner normalmente no requiere una API key real.
DASTXH_HSECSCAN_AI_TRANSLATION_API_KEY=not-needed

# Timeout por lote de traducción.
DASTXH_HSECSCAN_AI_TRANSLATION_TIMEOUT_SECONDS=300

# Temperatura baja para obtener traducciones más estables.
DASTXH_HSECSCAN_AI_TRANSLATION_TEMPERATURE=0.1

# Máximo de tokens de salida para traducciones hsecscan.
DASTXH_HSECSCAN_AI_TRANSLATION_MAX_OUTPUT_TOKENS=3000

# Cantidad de checks de hsecscan por llamada al modelo.
# Se deja en 1 porque el modelo local respondió mejor con registros individuales.
DASTXH_HSECSCAN_AI_TRANSLATION_BATCH_SIZE=1

# Límite máximo de checks de hsecscan que se enviarán a traducción.
DASTXH_HSECSCAN_AI_TRANSLATION_MAX_ITEMS=80

# Longitud máxima por campo traducible:
# security_description, recommendations y cwe.
DASTXH_HSECSCAN_AI_TRANSLATION_MAX_CHARS_PER_FIELD=650

# ==========================================================
# DASTXH - Interpretación de cookies con reglas + IA local
# Docker Model Runner / endpoint OpenAI-compatible
# ==========================================================
# Activa el análisis asistido de cookies.
#
# Importante:
# - El riesgo NO lo decide la IA desde cero.
# - DASTXH calcula primero el riesgo mediante reglas internas alineadas con OWASP + mapeo CWE.
# - La IA solo redacta una interpretación y recomendación breve en español latino.
# - Si la IA falla, se usa una explicación generada por reglas.
DASTXH_COOKIE_AI_ENABLED=true

# Se reutiliza el mismo endpoint local compatible con OpenAI.
DASTXH_COOKIE_AI_BASE_URL=http://model-runner.docker.internal:12434/engines/v1

# Se reutiliza el mismo modelo local.
DASTXH_COOKIE_AI_MODEL=ai/llama3.2

# Docker Model Runner normalmente no requiere una API key real.
DASTXH_COOKIE_AI_API_KEY=not-needed

# Timeout por lote de cookies.
DASTXH_COOKIE_AI_TIMEOUT_SECONDS=240

# Temperatura baja para respuestas más estables.
DASTXH_COOKIE_AI_TEMPERATURE=0.1

# Máximo de tokens para interpretación de cookies.
DASTXH_COOKIE_AI_MAX_OUTPUT_TOKENS=1800

# Cantidad de cookies por llamada al modelo.
# 2 es más estable que lotes grandes y suficiente para esta sección.
DASTXH_COOKIE_AI_BATCH_SIZE=2

# Límite máximo de cookies que se enviarán a análisis asistido.
DASTXH_COOKIE_AI_MAX_ITEMS=80

# ==========================================================
# DASTXH - Dalfox / XSS
# Flujo único: evaluación profunda controlada
# ==========================================================
# Ya no existen perfiles superficial/profundo visibles para el usuario.
#
# Configuración final para esta etapa:
# - Mining activado para no sacrificar cobertura.
# - DOM mining activado para conservar análisis de patrones asociados al DOM.
# - Dict/Gf-Patterns activado para mejorar cobertura de parámetros/patrones.
# - Workers reducidos a 6 porque el modo DOM profundo/headless puede consumir más recursos.
# - Timeout duro de 420 segundos para que Dalfox no consuma toda la ejecución.
#
# Objetivo operativo:
# - Mantener Dalfox por debajo del límite global de 16 minutos.
# - Dejar margen para cabeceras, hsecscan, cookies, IA, reportes y persistencia en BD.
# - En URLs públicas puede variar por latencia, bloqueo o respuesta del servidor.

# Timeout por solicitud individual de Dalfox.
# No es el límite total del proceso.
DASTXH_DALFOX_REQUEST_TIMEOUT_SECONDS=25

# Timeout duro del proceso completo Dalfox.
# 420 segundos = 7 minutos máximos para Dalfox.
# Esto deja margen antes del límite global de 16 minutos de la evaluación completa.
DASTXH_DALFOX_HARD_TIMEOUT_SECONDS=420

# Cantidad de workers de Dalfox.
# Se deja en 6 porque --deep-domxss y headless pueden consumir más recursos.
DASTXH_DALFOX_WORKERS=6

# Minería controlada.
# true = permite minería DOM/diccionario según los flags individuales.
# false = DASTXH agregará --skip-mining-dom y --skip-mining-dict.
DASTXH_DALFOX_LIGHT_MINING_ENABLED=true

# DOM mining.
# false = NO omitir DOM mining.
# Se deja en false para no perder cobertura en patrones XSS asociados al DOM.
DASTXH_DALFOX_SKIP_MINING_DOM=false

# Diccionario / Gf-Patterns.
# false = NO omitir minería por diccionario/Gf-Patterns.
# Se deja en false para mejorar cobertura de parámetros/patrones.
DASTXH_DALFOX_SKIP_MINING_DICT=false

# ==========================================================
# DASTXH - Dalfox / DOM XSS profundo controlado
# ==========================================================
# Activa pruebas DOM XSS más profundas.
# Internamente se traduce al flag:
#   --deep-domxss
DASTXH_DALFOX_DEEP_DOMXSS_ENABLED=true

# Fuerza verificación con navegador/headless cuando sea posible.
# Internamente se traduce al flag:
#   --force-headless-verification
DASTXH_DALFOX_FORCE_HEADLESS_VERIFICATION=true

# ==========================================================
# Grafana
# ==========================================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin